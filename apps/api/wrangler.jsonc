{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "babillard",
  "account_id": "04b61c9801867f8e9b37768bb3483b7b",
  "main": "src/index.ts",
  "workers_dev": false,
  "routes": [{ "pattern": "babillard.app", "custom_domain": true }],
  // The landing page, built from apps/site. Files that exist are served directly,
  // and every other path goes to the API.
  "assets": { "directory": "../site/public" },
  // Preview URLs would be public and share production data.
  "preview_urls": false,
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "babillard",
      "database_id": "4f409cc6-2ea5-40d7-ba6a-d185e993a046",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "babillard" }],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "COHORT", "class_name": "Cohort" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom", "Cohort"] }],
  "ratelimits": [
    { "name": "SIGN_IN_START_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SIGN_IN_VERIFY_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "CLIENT_ERROR_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://babillard.app",
    // Must be an address on a domain verified in SES.
    "EMAIL_FROM": "Babillard <login@danielthorp.com>",
    "SES_REGION": "ca-central-1",
    "SES_ENDPOINT": "",
    "PUSH_MODE": "expo",
    "LOGIN_EMAIL_HOURLY_CAP": "500",
    "EMAIL_LINKS_ON_WORKERS_DEV": "false",
    "DEV_MODE": "false",
    "ACCESS_TEAM_DOMAIN": "plain-lab-430e.cloudflareaccess.com",
    "ACCESS_AUD": "1a85a5c256e7112a4102ae7618d91089b6b4ab5f3c266222fec7c38e5d4a8bf7",
    "APPLE_APP_ID": "",
    "ANDROID_PACKAGE": "com.babillard",
    "ANDROID_CERT_SHA256": "03:61:92:0A:C1:8C:FF:A2:27:AB:1C:45:E1:9E:DD:52:DC:73:FD:37:7E:00:1C:2F:84:E9:36:BE:34:39:92:EB",
    "NUDGE_AFTER_MS": "",
    "MATCH_EXPIRY_MS": "",
    "MEETUP_REMINDER_LEAD_MS": "",
    "MEETUP_CHECKIN_DELAY_MS": ""
  }
}
