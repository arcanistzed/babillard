{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ideas-match-api",
  "account_id": "04b61c9801867f8e9b37768bb3483b7b",
  "main": "src/index.ts",
  "workers_dev": true,
  // Preview URLs would be public and share production data.
  "preview_urls": false,
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ideas-match",
      "database_id": "fe92edf7-f0ff-4497-b4bb-1ba46d15c854",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "ideas-match-avatars" }],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "COHORT", "class_name": "Cohort" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom", "Cohort"] }],
  "ratelimits": [
    { "name": "SIGN_IN_START_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SIGN_IN_VERIFY_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "CLIENT_ERROR_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://ideas-match-api.ideas-match.workers.dev",
    // Must be an address on a domain verified in SES.
    "EMAIL_FROM": "Ideas Match <login@danielthorp.com>",
    "SES_REGION": "ca-central-1",
    "SES_ENDPOINT": "",
    "PUSH_MODE": "expo",
    "LOGIN_EMAIL_HOURLY_CAP": "500",
    "EMAIL_LINKS_ON_WORKERS_DEV": "false",
    "DEV_MODE": "false",
    "ACCESS_TEAM_DOMAIN": "plain-lab-430e.cloudflareaccess.com",
    "ACCESS_AUD": "1a85a5c256e7112a4102ae7618d91089b6b4ab5f3c266222fec7c38e5d4a8bf7",
    "APPLE_APP_ID": "",
    "ANDROID_PACKAGE": "app.ideasmatch",
    "ANDROID_CERT_SHA256": "A7:F8:EA:6D:0A:53:65:D4:52:D2:D4:13:B5:E7:29:97:57:98:FD:F4:9E:97:7E:F8:7E:B0:1F:40:68:4E:C6:F3",
    "NUDGE_AFTER_MS": "",
    "MATCH_EXPIRY_MS": "",
    "MEETUP_REMINDER_LEAD_MS": "",
    "MEETUP_CHECKIN_DELAY_MS": ""
  }
}
