{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ideas-match-api",
  "account_id": "04b61c9801867f8e9b37768bb3483b7b",
  "main": "src/index.ts",
  "workers_dev": true,
  // Preview URLs would be public and share production data.
  "preview_urls": false,
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ideas-match",
      "database_id": "fe92edf7-f0ff-4497-b4bb-1ba46d15c854",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "ideas-match-avatars" }],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "COHORT", "class_name": "Cohort" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom", "Cohort"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://ideas-match-api.ideas-match.workers.dev",
    // Must be an address on a domain verified in SES.
    "EMAIL_FROM": "Ideas Match <login@danielthorp.com>",
    "SES_REGION": "ca-central-1",
    "SES_ENDPOINT": "",
    "PUSH_MODE": "expo",
    "DEV_MODE": "false",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "APPLE_APP_ID": "",
    "ANDROID_PACKAGE": "app.ideasmatch",
    "ANDROID_CERT_SHA256": "",
    "NUDGE_AFTER_MS": "",
    "MATCH_EXPIRY_MS": "",
    "MEETUP_REMINDER_LEAD_MS": "",
    "MEETUP_CHECKIN_DELAY_MS": ""
  }
}
