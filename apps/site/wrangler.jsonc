{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The landing page, and the public front door for the API.
  // danielthorp.com is in the Personal account and the API is in the Ideas Match
  // account. A custom domain has to be in the same account as its Worker, so this
  // Worker serves the domain and forwards everything that isn't the site to the API.
  // If Ideas Match gets its own domain, attach it to the API directly and retire this.
  "name": "ideas-match-site",
  "account_id": "e29f1718177589c94510db0553fe0024",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ideasmatch.danielthorp.com", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  "vars": {
    "API_ORIGIN": "https://ideas-match-api.ideas-match.workers.dev"
  }
  // Secret: PROXY_KEY, the same value as the API's. It lets the API trust the
  // visitor IP this Worker passes along, which sign-in rate limits are keyed on.
}
