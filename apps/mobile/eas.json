{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "node": "24.18.1",
      "pnpm": "11.1.3",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8787"
      }
    },
    "preview": {
      "node": "24.18.1",
      "pnpm": "11.1.3",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://babillard.app"
      }
    },
    "production": {
      "node": "24.18.1",
      "pnpm": "11.1.3",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://babillard.app"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
